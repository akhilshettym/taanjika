# The database user with administrative or read/write privileges
POSTGRES_USER=postgres

# The secure password for the database user (use a strong secret in production)
POSTGRES_PASSWORD=password

# The name of the PostgreSQL database instance
POSTGRES_DB=taanjika_db

# The port on which PostgreSQL is exposed (default is 5432)
POSTGRES_PORT=5432

# Complete connection string required by Prisma ORM
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Maximum number of concurrent connections in the database connection pool 
# (Adjust this based on your database tier and expected concurrent traffic to prevent exhaustion)
DB_POOL_MAX=10


# Comma-separated list of allowed frontend origins for CORS policy (e.g., local dev and production domain)
CORS_ORIGINS=

# The port on which the NestJS backend server listens
PORT=4000