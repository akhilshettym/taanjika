# Firebase Admin SDK
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Add these to the Moola environment file or the monorepo root .env.

# Legal document versions. The backend owns these values.
TERMS_VERSION=
PRIVACY_VERSION=

# Server-side administrator bootstrap
ADMIN_BOOTSTRAP_ENABLED=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD_VERSION=

# Database
DB_SSL=
